<configuration>
  <!-- Suppress Logback's own startup status messages -->
  <statusListener class="ch.qos.logback.core.status.NopStatusListener" />

  <!--
    No console appender is declared here. FormattedListener attaches a
    ListAppender programmatically and drains captured logs into the phase
    box so that log output never interleaves with the box-drawing UI.
    In -vv mode, LoggingListener adds a ConsoleAppender programmatically
    so that logs flow to stdout.
  -->

  <!-- iText font subsystem is very chatty at WARN; keep it at ERROR -->
  <logger name="com.itextpdf.kernel.font" level="error" />

  <!-- iText structure tree warns about duplicate StructParent indices in
       malformed PDFs; not actionable by the user -->
  <logger name="com.itextpdf.kernel.pdf.tagging" level="error" />

  <!-- ParentTreeHandler.registerAllMcrs() logs one ERROR per orphaned MCR
       when opening a PDF whose pages were deleted in Acrobat without tag
       cleanup. We detect/report orphans ourselves via OrphanedContentCheck,
       so suppress iText's per-MCR error to keep the box UI readable. This
       is the only LOGGER.error() in ParentTreeHandler; fatal cases throw. -->
  <logger name="com.itextpdf.kernel.pdf.tagging.ParentTreeHandler" level="off" />

  <root level="warn" />
</configuration>
